# --- Required ---
DATABASE_URL="postgresql://user:pass@ep-xxxx.neon.tech/vidmaker?sslmode=require"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="generate-a-32+-char-random-string"
# Your deployed URL in production, e.g. https://vidmaker.vercel.app
BETTER_AUTH_URL="http://localhost:3000"
# Only these emails can create an account (comma-separated)
OWNER_EMAILS="you@example.com"

# --- Google OAuth (optional — email+password works without it) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe (optional — billing is deferred while this is a private tool) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Resend (optional — without it, password-reset links go to the server log) ---
RESEND_API_KEY=
EMAIL_FROM="VidMaker <onboarding@resend.dev>"

# --- Script writing (optional — with no key below and no AI Gateway key, you write scripts by hand) ---
# Any ONE key turns AI scripts on. With several set, they are tried in this
# order and the next one takes over on a rate limit or error.
# Names: gateway, gemini, groq, cerebras, mistral, openrouter. Put free ones
# first to avoid paid gateway calls, e.g. "gemini,groq,gateway".
TEXT_PROVIDER_ORDER="gateway,gemini,groq,cerebras,mistral,openrouter"
# Free tiers, no credit card. Get each key from the provider's own site:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL="gemini-3.6-flash"
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL="llama-3.3-70b-versatile"
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL="gpt-oss-120b"
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL="mistral-small-latest"
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL="openrouter/free"

# --- Vercel AI Gateway (draws scene images and can write scripts; without it you get stock footage) ---
AI_GATEWAY_API_KEY=
# Script model used when the gateway writes the script
SCRIPT_MODEL="openai/gpt-5-mini"
# Scene illustrations also use AI Gateway (any gateway image model)
IMAGE_MODEL="bfl/flux-2-pro"

# --- ElevenLabs (required to make videos — voiceover) ---
ELEVENLABS_API_KEY=
# Optional: any voice ID from your ElevenLabs voice library (default: George)
ELEVENLABS_VOICE_ID=

# --- Pexels (optional — stock footage, used only when AI_GATEWAY_API_KEY is not set) ---
PEXELS_API_KEY=

# --- Vercel Blob (required to make videos — stores narration audio; use a PUBLIC store) ---
# Set automatically when you connect a Blob store in the Vercel dashboard.
# Newer stores set BLOB_STORE_ID; older ones set BLOB_READ_WRITE_TOKEN. Either works.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# --- Shotstack (required to make videos — renders the MP4) ---
SHOTSTACK_API_KEY=
# "v1" = production (paid, no watermark; needs your PRODUCTION key), "stage" = free sandbox (watermarked; needs the SANDBOX key)
SHOTSTACK_ENV="v1"

# --- Background music (optional — a public MP3 URL you have rights to use) ---
BACKGROUND_MUSIC_URL=

# --- Higgsfield / Wan 3.0 Prime (optional — reserved for AI B-roll, not wired yet) ---
HIGGSFIELD_API_KEY=
HIGGSFIELD_SECRET=
HIGGSFIELD_CALLBACK=

# --- Cron (required in production) ---
# Generate with: openssl rand -hex 32
CRON_SECRET=
