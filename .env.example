# --- Required ---
DATABASE_URL="postgresql://user:pass@ep-xxxx.neon.tech/vidmaker?sslmode=require"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="generate-a-32+-char-random-string"
# Your deployed URL in production, e.g. https://vidmaker.vercel.app
BETTER_AUTH_URL="http://localhost:3000"
# Only these emails can create an account (comma-separated)
OWNER_EMAILS="you@example.com"

# --- Google OAuth (optional — email+password works without it) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe (optional — billing is deferred while this is a private tool) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Resend (optional — without it, password-reset links go to the server log) ---
RESEND_API_KEY=
EMAIL_FROM="VidMaker <onboarding@resend.dev>"

# --- Vercel AI Gateway (optional — without it you write scripts by hand) ---
AI_GATEWAY_API_KEY=
SCRIPT_MODEL="openai/gpt-5-mini"

# --- ElevenLabs (required to make videos — voiceover) ---
ELEVENLABS_API_KEY=
# Optional: any voice ID from your ElevenLabs voice library (default: George)
ELEVENLABS_VOICE_ID=

# --- Pexels (required to make videos — free stock footage) ---
PEXELS_API_KEY=

# --- Vercel Blob (required to make videos — stores narration audio) ---
# Created automatically when you add a Blob store in the Vercel dashboard
BLOB_READ_WRITE_TOKEN=

# --- Shotstack (required to make videos — renders the MP4) ---
SHOTSTACK_API_KEY=
# "stage" = free sandbox (watermarked), "v1" = production (paid, no watermark)
SHOTSTACK_ENV="stage"

# --- Background music (optional — a public MP3 URL you have rights to use) ---
BACKGROUND_MUSIC_URL=

# --- Higgsfield / Wan 3.0 Prime (optional — reserved for AI B-roll, not wired yet) ---
HIGGSFIELD_API_KEY=
HIGGSFIELD_SECRET=
HIGGSFIELD_CALLBACK=

# --- Cron (required in production) ---
# Generate with: openssl rand -hex 32
CRON_SECRET=
